# Copia este archivo a asterisk/.env en el VPS y llena los valores.
# NUNCA subas asterisk/.env al repositorio.

# Subdominio que apunta al VPS (registro DNS tipo A) y su IP pública.
PUBLIC_DOMAIN=voz.tudominio.com
PUBLIC_IP=203.0.113.10

# Credencial con la que el navegador se autentica ante este Asterisk.
# Debe coincidir con VOICE_SIP_USER y VOICE_SIP_PASSWORD en Vercel.
SIP_WEB_USER=webpaciente
SIP_WEB_PASSWORD=cambia-esto-por-una-clave-larga

# Datos del canal "Heynow Asterisk" creado en el portal de HeyNow.
HEY_DID=9990001
HEY_AUTH_TOKEN=REEMPLAZAR_TOKEN

# Opcionales
RTP_START=10000
RTP_END=10100
MAX_CONCURRENT_CALLS=3
MAX_CALL_SECONDS=900
