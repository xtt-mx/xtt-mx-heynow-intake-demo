# Variables de la app (Vercel → Project → Settings → Environment Variables).
# En local: copia este archivo a .env.local. NUNCA subas .env* con valores reales.

# Postgres (Neon). La integración Neon de Vercel la crea sola. Sin ella, en local se
# usa memoria; en producción la app falla de forma visible.
DATABASE_URL=

# Token que HeyNow envía al llamar al MCP (/api/mcp) o a /api/intake.
# Genera uno largo: openssl rand -hex 32
INTAKE_API_TOKEN=

# Vercel Cron lo envía como "Bearer CRON_SECRET" a /api/cron/purge.
CRON_SECRET=

# Días que se conserva cada ficha antes de borrarse (máx. 365).
RETENTION_DAYS=30

# Acceso a /llamar (paciente) y a /medico (médico). Autenticación básica.
DEMO_PATIENT_USER=paciente
DEMO_PATIENT_PASSWORD=
DEMO_DOCTOR_USER=medico
DEMO_DOCTOR_PASSWORD=

# Softphone del navegador → Asterisk del VPS (ver asterisk/.env.example).
VOICE_WSS_URL=wss://voz.tudominio.com:8089/ws
VOICE_SIP_DOMAIN=voz.tudominio.com
VOICE_SIP_USER=webpaciente
VOICE_SIP_PASSWORD=
VOICE_TARGET=preconsulta

# Opcional: servidor TURN para redes que bloquean el audio por UDP.
VOICE_TURN_URL=
VOICE_TURN_USER=
VOICE_TURN_PASSWORD=
